{
	"extends": "@repo/tsconfig/base.json",
	"compilerOptions": {
		"outDir": "dist",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"noEmit": true,
		"baseUrl": "../..",
		"paths": {
			"@repo/core": ["packages/core/src/index.ts"],
			"@repo/core/*": ["packages/core/src/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"e2e/**/*.ts",
		"vite.config.ts",
		"playwright.config.ts"
	],
	"exclude": ["node_modules", "dist"]
}
