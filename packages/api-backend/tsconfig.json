{
	"extends": "@repo/tsconfig/base.json",
	"compilerOptions": {
		"outDir": "dist",
		"lib": ["ES2022"],
		"noEmit": false,
		"baseUrl": "../..",
		"paths": {
			"@repo/core": ["packages/core/src/index.ts"],
			"@repo/core/*": ["packages/core/src/*"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
