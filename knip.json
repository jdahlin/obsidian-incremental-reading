{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		"packages/obsidian": {
			"project": ["src/**/*.{ts,tsx}"],
			"entry": ["src/main.ts", "src/**/tests/*.test.ts"],
			"ignoreDependencies": ["obsidian", "sql.js"]
		},
		"packages/cli": {
			"project": ["src/**/*.{ts,tsx}"]
		},
		"packages/anki-importer": {
			"project": ["src/**/*.{ts,tsx}"],
			"entry": ["src/tests/**/*.test.ts"]
		},
		"packages/core": {
			"project": ["src/**/*.{ts,tsx}"],
			"entry": ["src/tests/**/*.test.ts"]
		},
		"packages/web": {
			"project": ["src/**/*.{ts,tsx}"],
			"entry": ["src/main.tsx", "src/adapters/index.ts"]
		},
		"packages/api-backend": {
			"project": ["src/**/*.ts"],
			"entry": ["src/db/*.ts"]
		},
		"packages/hub": {
			"project": ["src/**/*.{ts,tsx}"],
			"entry": [
				"src/main.tsx",
				"src/components/ui/*.tsx",
				"src/data/mockData.ts",
				"src/hooks/*.ts",
				"src/components/MiniCalendar.tsx"
			],
			"ignoreDependencies": [
				"@hookform/resolvers",
				"@radix-ui/*",
				"baseline-browser-mapping",
				"caniuse-lite",
				"cmdk",
				"date-fns",
				"embla-carousel-react",
				"input-otp",
				"react-day-picker",
				"react-hook-form",
				"react-resizable-panels",
				"recharts",
				"vaul",
				"zod",
				"@tailwindcss/typography"
			]
		},
		"packages/shell": {
			"project": ["src/**/*.{ts,tsx}"],
			"entry": ["src/main.tsx"]
		},
		"configs/vitest": {
			"ignoreDependencies": ["vite"]
		},
		"configs/ts": {
			"ignoreDependencies": ["preact"]
		}
	},
	"ignore": ["**/*.d.ts", "**/dist/**", "**/coverage/**", "**/main.js"]
}
